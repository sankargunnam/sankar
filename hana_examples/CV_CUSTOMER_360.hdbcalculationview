        <mapping xsi:type="Calculation:AttributeMapping" target="STATUS" source="STATUS"/>
        <mapping xsi:type="Calculation:AttributeMapping" target="TOTAL_PURCHASES" source="TOTAL_PURCHASES"/>
        <mapping xsi:type="Calculation:AttributeMapping" target="TOTAL_REVENUE" source="TOTAL_REVENUE"/>
        <mapping xsi:type="Calculation:AttributeMapping" target="AVG_ORDER_VALUE" source="AVG_ORDER_VALUE"/>
        <mapping xsi:type="Calculation:AttributeMapping" target="LAST_PURCHASE_DATE" source="LAST_PURCHASE_DATE"/>
        <mapping xsi:type="Calculation:AttributeMapping" target="TRANSACTION_COUNT" source="TRANSACTION_COUNT"/>
      </input>

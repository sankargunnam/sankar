        <mapping xsi:type="Calculation:AttributeMapping" target="LAST_INTERACTION_DATE" source="LAST_INTERACTION_DATE"/>
        <mapping xsi:type="Calculation:AttributeMapping" target="SUPPORT_TICKETS" source="SUPPORT_TICKETS"/>

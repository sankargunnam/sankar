    <!-- Join: Add Interactions -->
    <calculationView xsi:type="Calculation:JoinView" id="Join_Customer_360" joinType="leftOuter">
      <descriptions/>
      <viewAttributes>
        <viewAttribute id="CUSTOMER_ID"/>
        <viewAttribute id="CUSTOMER_NAME"/>
        <viewAttribute id="EMAIL"/>
        <viewAttribute id="PHONE"/>
        <viewAttribute id="ADDRESS"/>
        <viewAttribute id="CITY"/>
        <viewAttribute id="STATE"/>
        <viewAttribute id="COUNTRY"/>
        <viewAttribute id="POSTAL_CODE"/>
        <viewAttribute id="REGION"/>
        <viewAttribute id="SEGMENT"/>
        <viewAttribute id="INDUSTRY"/>
        <viewAttribute id="CREATED_DATE"/>
        <viewAttribute id="STATUS"/>
        <viewAttribute id="TOTAL_PURCHASES" aggregationType="sum"/>
        <viewAttribute id="TOTAL_REVENUE" aggregationType="sum"/>
        <viewAttribute id="AVG_ORDER_VALUE" aggregationType="avg"/>
        <viewAttribute id="LAST_PURCHASE_DATE"/>
        <viewAttribute id="TRANSACTION_COUNT" aggregationType="sum"/>
        <viewAttribute id="TOTAL_INTERACTIONS" aggregationType="sum"/>
        <viewAttribute id="LAST_INTERACTION_DATE"/>
        <viewAttribute id="SUPPORT_TICKETS" aggregationType="sum"/>
        <viewAttribute id="SALES_CALLS" aggregationType="sum"/>
      </viewAttributes>
      <calculatedViewAttributes>
        <calculatedViewAttribute datatype="NVARCHAR" id="CUSTOMER_TIER" length="20" expressionLanguage="COLUMN_ENGINE">
          <formula>CASE 
            WHEN TOTAL_REVENUE > 100000 THEN 'PLATINUM'
            WHEN TOTAL_REVENUE > 50000 THEN 'GOLD'
            WHEN TOTAL_REVENUE > 10000 THEN 'SILVER'
            ELSE 'BRONZE'
          END</formula>
        </calculatedViewAttribute>
        <calculatedViewAttribute datatype="INTEGER" id="DAYS_SINCE_LAST_PURCHASE" expressionLanguage="COLUMN_ENGINE">
          <formula>DAYS_BETWEEN(LAST_PURCHASE_DATE, CURRENT_DATE)</formula>
        </calculatedViewAttribute>
        <calculatedViewAttribute datatype="NVARCHAR" id="ENGAGEMENT_LEVEL" length="20" expressionLanguage="COLUMN_ENGINE">
          <formula>CASE 
            WHEN TOTAL_INTERACTIONS > 50 THEN 'HIGH'
            WHEN TOTAL_INTERACTIONS > 20 THEN 'MEDIUM'
            ELSE 'LOW'
          END</formula>
        </calculatedViewAttribute>
      </calculatedViewAttributes>

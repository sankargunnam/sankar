    <!-- Aggregation: Transaction Summary -->
    <calculationView xsi:type="Calculation:AggregationView" id="Agg_Transactions">
      <descriptions/>
      <viewAttributes>
        <viewAttribute id="CUSTOMER_ID"/>
        <viewAttribute id="TOTAL_PURCHASES" aggregationType="sum"/>
        <viewAttribute id="TOTAL_REVENUE" aggregationType="sum"/>
        <viewAttribute id="AVG_ORDER_VALUE" aggregationType="avg"/>
        <viewAttribute id="LAST_PURCHASE_DATE" aggregationType="max"/>
      </viewAttributes>
      <calculatedViewAttributes>
        <calculatedViewAttribute datatype="INTEGER" id="TRANSACTION_COUNT" expressionLanguage="COLUMN_ENGINE">
          <formula>COUNT(TRANSACTION_ID)</formula>
        </calculatedViewAttribute>
      </calculatedViewAttributes>
      <restrictedViewAttributes/>
      <input node="CUSTOMER_TRANSACTIONS">
        <mapping xsi:type="Calculation:AttributeMapping" target="CUSTOMER_ID" source="CUSTOMER_ID"/>
        <mapping xsi:type="Calculation:AttributeMapping" target="TOTAL_PURCHASES" source="PURCHASE_AMOUNT"/>
        <mapping xsi:type="Calculation:AttributeMapping" target="TOTAL_REVENUE" source="REVENUE"/>
        <mapping xsi:type="Calculation:AttributeMapping" target="AVG_ORDER_VALUE" source="ORDER_VALUE"/>
        <mapping xsi:type="Calculation:AttributeMapping" target="LAST_PURCHASE_DATE" source="TRANSACTION_DATE"/>
      </input>
    </calculationView>
    
    <!-- Aggregation: Interaction Summary -->
    <calculationView xsi:type="Calculation:AggregationView" id="Agg_Interactions">
      <descriptions/>
      <viewAttributes>
        <viewAttribute id="CUSTOMER_ID"/>
        <viewAttribute id="TOTAL_INTERACTIONS" aggregationType="sum"/>
        <viewAttribute id="LAST_INTERACTION_DATE" aggregationType="max"/>
      </viewAttributes>
      <calculatedViewAttributes>
        <calculatedViewAttribute datatype="INTEGER" id="SUPPORT_TICKETS" expressionLanguage="COLUMN_ENGINE">
          <formula>COUNT(CASE WHEN INTERACTION_TYPE = 'SUPPORT' THEN 1 END)</formula>
        </calculatedViewAttribute>
        <calculatedViewAttribute datatype="INTEGER" id="SALES_CALLS" expressionLanguage="COLUMN_ENGINE">
          <formula>COUNT(CASE WHEN INTERACTION_TYPE = 'SALES' THEN 1 END)</formula>
        </calculatedViewAttribute>
      </calculatedViewAttributes>
      <restrictedViewAttributes/>
      <input node="CUSTOMER_INTERACTIONS">
        <mapping xsi:type="Calculation:AttributeMapping" target="CUSTOMER_ID" source="CUSTOMER_ID"/>
        <mapping xsi:type="Calculation:AttributeMapping" target="TOTAL_INTERACTIONS" source="INTERACTION_COUNT"/>
        <mapping xsi:type="Calculation:AttributeMapping" target="LAST_INTERACTION_DATE" source="INTERACTION_DATE"/>
      </input>
    </calculationView>
    
